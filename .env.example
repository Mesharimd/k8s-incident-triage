# Webhook receiver
PORT=3000
ALERT_DEBOUNCE_SECONDS=300
MIN_SEVERITY=warning
NAMESPACE_ALLOWLIST=
NAMESPACE_DENYLIST=kube-system

# Read-only observability APIs
PROMETHEUS_URL=http://prometheus-operated.monitoring.svc:9090
# Set KUBERNETES_API_URL only for local fixture/integration testing. In-cluster,
# KUBERNETES_SERVICE_HOST and KUBERNETES_SERVICE_PORT_HTTPS are injected.
KUBERNETES_API_URL=
KUBERNETES_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBERNETES_CA_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# Opt in only while running tests under the restricted ServiceAccount.
K8S_RBAC_LIVE_TEST=0
K8S_RBAC_TEST_NAMESPACE=default
