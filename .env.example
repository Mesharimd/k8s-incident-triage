# Webhook receiver
PORT=3000
ALERT_DEBOUNCE_SECONDS=300
MIN_SEVERITY=warning
NAMESPACE_ALLOWLIST=
NAMESPACE_DENYLIST=kube-system
INCIDENT_QUEUE_CAPACITY=100
INCIDENT_CONCURRENCY=2
INCIDENT_STATE_CAPACITY=1000

# Read-only observability APIs
PROMETHEUS_URL=http://prometheus-operated.monitoring.svc:9090
# Set KUBERNETES_API_URL only for local fixture/integration testing. In-cluster,
# KUBERNETES_SERVICE_HOST and KUBERNETES_SERVICE_PORT_HTTPS are injected.
KUBERNETES_API_URL=
KUBERNETES_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBERNETES_CA_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# Opt in only while running tests under the restricted ServiceAccount.
K8S_RBAC_LIVE_TEST=0
K8S_RBAC_TEST_NAMESPACE=default

# Bounded agent loop
# LLM_PROVIDER selects the adapter: "anthropic" or "openrouter".
LLM_PROVIDER=openrouter
AGENT_MAX_TOOL_CALLS=10
AGENT_CONTEXT_TOKENS=32000
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_CONTEXT_SAFETY_TOKENS=1024
AGENT_INCIDENT_TIMEOUT_MS=75000
TRACE_DIR=./traces

# --- Provider: OpenRouter (one key, many models — openrouter.ai) ---
# Model must support reliable tool calling and structured output; good picks:
#   openai/gpt-4o-mini · google/gemini-2.5-flash · deepseek/deepseek-chat
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=15000
OPENROUTER_MAX_RETRIES=0

# --- Provider: Anthropic (optional when LLM_PROVIDER=openrouter) ---
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_MS=15000
ANTHROPIC_MAX_RETRIES=0

# Telegram delivery (keep real values only in the ignored .env)
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=<your-private-chat-or-channel-id>
TELEGRAM_TIMEOUT_MS=40000

# Opt in explicitly; these tests make billable API requests.
ANTHROPIC_LIVE_TEST=0
OPENROUTER_LIVE_TEST=0
